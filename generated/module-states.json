      "emphasis": "quiet",
      "allowsPrimaryAction": true,
      "allowsSecondaryAction": true,
      "allowsRetry": false,
      "consumerProvides": [
        "applicability",
        "authorization",
        "entitlement",
        "tenant-or-resource-context",
        "lifecycle-transition"
      ]
    },
    "setup-required": {
      "id": "setup-required",
      "label": "Setup required",
