{
  "name": "ten4seven-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic, token-driven UI operating system for frontend agents and developers.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "inventory": "node scripts/collect-inventory.mjs",
    "icons:generate": "node scripts/generate-solar-subset.mjs && node scripts/generate-solar-catalog.mjs && node scripts/generate-curated-icon-subset.mjs",
    "dev": "pnpm --filter @ten4seven/playground dev",
    "t7ui": "node packages/ai/bin/t7ui.mjs",
    "contracts:generate": "node --experimental-strip-types scripts/generate-contract-projections.mjs && node --experimental-strip-types scripts/generate-theme-recipes-css.mjs && node --experimental-strip-types scripts/generate-dtcg-token-export.mjs",
    "corpus:generate": "node --experimental-strip-types scripts/component-corpus-ledger.mjs",
    "themes:generate": "node --experimental-strip-types scripts/generate-theme-recipes-css.mjs",
    "tokens:generate": "node --experimental-strip-types scripts/generate-dtcg-token-export.mjs",
    "tokens:coverage": "node scripts/generate-component-token-coverage.mjs",
    "build": "pnpm --filter @ten4seven/playground build",
    "package:build": "pnpm --filter @ten4seven/ui build",
    "package:verify": "pnpm --filter @ten4seven/ui verify",
    "package:release": "pnpm --filter @ten4seven/ui pack:release",
    "measure:erp-readiness": "node scripts/measure-erp-readiness.mjs",
    "test:next-consumer": "node scripts/test-next-app-router-consumer.mjs",
    "typecheck": "pnpm --filter @ten4seven/contracts typecheck && pnpm --filter @ten4seven/native typecheck && pnpm --filter @ten4seven/agent typecheck && pnpm --filter @ten4seven/agent build && pnpm --filter @ten4seven/playground typecheck",
    "test": "pnpm test:contracts && pnpm test:responsive-contracts && pnpm test:layout-contracts && pnpm test:saas-control-plane && pnpm test:farm-reference && pnpm test:native-mobile && pnpm test:native-expo && pnpm test:visualization && pnpm test:workflow-productivity && pnpm test:composition && pnpm test:advanced-interactions && pnpm test:erp-readiness && pnpm test:dtcg && pnpm test:contrast && pnpm test:token-governance && pnpm test:component-coverage && pnpm test:slice-a && pnpm test:brand-expression && pnpm test:recipe-family && pnpm --filter @ten4seven/tokens test && pnpm test:ai && pnpm test:final-ai-acceptance && pnpm test:component-system && pnpm test:component-corpus && pnpm test:tailwind-bridge",
    "test:contracts": "node --experimental-strip-types scripts/verify-contracts.mjs",
    "test:responsive-contracts": "node --experimental-strip-types scripts/verify-responsive-contracts.mjs",
    "test:layout-contracts": "node --experimental-strip-types scripts/verify-layout-contracts.mjs",
    "test:saas-control-plane": "node --experimental-strip-types scripts/verify-saas-control-plane.mjs",
    "test:farm-reference": "node --experimental-strip-types scripts/verify-farm-reference.mjs",
    "test:native-mobile": "node --experimental-strip-types scripts/verify-native-mobile.mjs",
    "test:native-expo": "node --experimental-strip-types scripts/verify-native-expo.mjs",
    "test:visualization": "node --experimental-strip-types scripts/verify-visualization.mjs",
    "test:workflow-productivity": "node --experimental-strip-types scripts/verify-workflow-productivity.mjs",
    "test:composition": "node --experimental-strip-types scripts/verify-composition.mjs",
    "test:advanced-interactions": "node --experimental-strip-types scripts/verify-editor-builder-ai.mjs",
    "test:erp-readiness": "node scripts/verify-erp-readiness.mjs",
    "test:dtcg": "node --experimental-strip-types scripts/verify-dtcg-token-export.mjs",
    "test:contrast": "node --experimental-strip-types scripts/verify-semantic-contrast.mjs",
    "test:token-governance": "node scripts/verify-token-governance.mjs",
    "test:component-coverage": "node scripts/verify-component-token-coverage.mjs",
    "test:slice-a": "node scripts/verify-slice-a.mjs",
    "test:brand-expression": "node --experimental-strip-types scripts/verify-brand-expression.mjs && pnpm test:brand-profiles",
    "test:brand-profiles": "node --experimental-strip-types scripts/verify-aapm-brand-profiles.mjs",
    "test:recipe-family": "node --experimental-strip-types scripts/verify-recipe-family.mjs",
    "test:e2e": "playwright test",
    "test:adoption": "playwright test --config=adoption.playwright.config.ts",
    "test:adoption:static": "node scripts/verify-adoption.mjs",
    "test:visual:update": "playwright test tests/visual-regression.spec.ts --update-snapshots",
    "test:ai": "node scripts/verify-ai-catalog.mjs && node scripts/verify-reference-cold-start.mjs",
    "test:final-ai-acceptance": "node scripts/verify-final-ai-acceptance.mjs",
    "test:component-system": "node scripts/verify-component-system.mjs",
    "test:component-corpus": "node scripts/verify-component-corpus.mjs",
    "test:tailwind-bridge": "node scripts/verify-tailwind-bridge.mjs",
    "test:consistency": "node scripts/verify-ui-consistency.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.13.0",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
