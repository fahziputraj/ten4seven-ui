      "emphasis": "quiet",
      "allowsPrimaryAction": false,
      "allowsSecondaryAction": true,
      "allowsRetry": false,
      "consumerProvides": [
        "applicability",
        "authorization",
        "entitlement",
        "tenant-or-resource-context",
        "lifecycle-transition"
      ]
    },
    "not-entitled": {
      "id": "not-entitled",
      "label": "Not entitled",
      "tone": "neutral",
      "icon": "lock",
      "defaultTitle": "This module is not included",
