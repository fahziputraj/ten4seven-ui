    "provider": "solar:cart-check-bold-duotone",
    "useWhen": ["checkout", "purchase"]
  },
  "favorite": {
    "provider": "solar:heart-angle-bold-duotone",
    "useWhen": ["favorite", "save for later"]
  },
  "rating": {
    "provider": "solar:star-bold-duotone",
