{
  "dashboard": {
    "provider": "solar:home-angle-bold-duotone",
    "useWhen": ["application home", "overview"]
  },
  "tokens": {
    "provider": "solar:layers-bold-duotone",
    "useWhen": ["design tokens", "layers"]
  },
  "components": {
    "provider": "solar:widget-5-bold-duotone",
    "useWhen": ["component library", "surfaces"]
  },
  "theme": {
    "provider": "solar:palette-bold-duotone",
    "useWhen": ["theme", "appearance", "color"]
  },
  "settings": {
    "provider": "solar:settings-bold-duotone",
    "useWhen": ["settings", "preferences"]
