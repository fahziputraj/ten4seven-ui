      "allowsPrimaryAction": false,
      "allowsSecondaryAction": true,
      "allowsRetry": false,
      "consumerProvides": [
        "applicability",
        "authorization",
        "entitlement",
        "tenant-or-resource-context",
        "lifecycle-transition"
      ]
    },
